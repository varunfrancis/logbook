{
  "name": "swarmville",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Swarmville: everything your Claude Code agents are doing, told as a little town. Runs locally.",
  "bin": {
    "swarmville": "bin/swarmville.ts"
  },
  "scripts": {
    "start": "node --no-warnings daemon/server.ts",
    "dev": "concurrently -k \"node --no-warnings --watch daemon/server.ts\" \"vite\"",
    "build": "vite build",
    "test": "node --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
